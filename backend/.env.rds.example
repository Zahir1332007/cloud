DATABASE_URL=postgresql://postgres:<TU_PASSWORD_DE_RDS>@database-1-instance-1.cdwwom8ggmi8.us-east-2.rds.amazonaws.com:5432/postgres?sslmode=require

# Parámetros de seguridad
SECRET_KEY=super-secret-key-change-in-production-aws-cloudstore-2026
ENVIRONMENT=production

