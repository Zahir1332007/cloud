# ==============================================================================
# CloudStore E-Commerce - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a ".env" y ajusta los valores según tu entorno.

# ------------------------------------------------------------------------------
# 1. Aplicación
# ------------------------------------------------------------------------------
PROJECT_NAME="CloudStore E-Commerce"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT)
# ------------------------------------------------------------------------------
SECRET_KEY="cambia-esta-clave-secreta-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Base de Datos PostgreSQL (credenciales separadas - AWS RDS o local)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudstore
DB_USER=postgres
DB_PASSWORD=postgres123
# Usa "verify-full" para AWS RDS y "disable" para PostgreSQL local sin SSL
DB_SSLMODE=disable
# Certificado raíz oficial de AWS RDS (necesario cuando DB_SSLMODE=verify-full)
DB_SSLROOTCERT=./global-bundle.pem

# ------------------------------------------------------------------------------
# 4. Contenedor PostgreSQL local (usado solo por docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=cloudstore

# ------------------------------------------------------------------------------
# 5. Opcional: URL completa (sobreescribe DB_* si se define)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/cloudstore
