# ==============================================================================
# CloudStore E-Commerce - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a ".env" y ajusta los valores según tu entorno.

# ------------------------------------------------------------------------------
# 1. Aplicación
# ------------------------------------------------------------------------------
PROJECT_NAME="CloudStore E-Commerce"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT)
# ------------------------------------------------------------------------------
SECRET_KEY="cambia-esta-clave-secreta-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Base de Datos MySQL (credenciales separadas - Local o AWS RDS MySQL)
# ------------------------------------------------------------------------------
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudstore
DB_USER=root
DB_PASSWORD=mysql123
# Usa "verify-full" para AWS RDS MySQL y "disable" para MySQL local sin SSL
DB_SSLMODE=disable
# Certificado raíz oficial de AWS RDS (necesario cuando DB_SSLMODE=verify-full)
DB_SSLROOTCERT=./global-bundle.pem

# ------------------------------------------------------------------------------
# 4. Contenedor MySQL local (usado solo por docker-compose.yml)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=mysql123
MYSQL_DATABASE=cloudstore
MYSQL_USER=cloudstore
MYSQL_PASSWORD=mysql123

# ------------------------------------------------------------------------------
# 5. Opcional: URL completa (sobreescribe DB_* si se define)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql+pymysql://root:mysql123@localhost:3306/cloudstore?charset=utf8mb4
